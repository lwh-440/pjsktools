# Non-secret runtime settings. Install as /etc/pjsktools/compliance.env (0600).
COMPLIANCE_LOG_DIR=/var/log/pjsktools
COMPLIANCE_STATE_DIR=/var/lib/pjsktools-compliance
COMPLIANCE_LOCAL_LOG_DAYS=200
COMPLIANCE_BACKUP_DIR=/var/backups/pjsktools
COMPLIANCE_TOMBSTONE_DIR=/var/backups/pjsktools/tombstones
# Plaintext exists only while validating/encrypting and contains HMAC hashes,
# never raw user IDs or email addresses. Prefer a root-only tmpfs.
COMPLIANCE_TOMBSTONE_PLAINTEXT_DIR=/dev/shm/pjsktools-tombstones
COMPLIANCE_DAILY_BACKUP_DAYS=35
COMPLIANCE_WEEKLY_BACKUP_DAYS=92
COMPLIANCE_TOMBSTONE_DAYS=200
COMPLIANCE_COS_LOG_PREFIX=logs
COMPLIANCE_COS_DAILY_PREFIX=backups/daily
COMPLIANCE_COS_WEEKLY_PREFIX=backups/weekly
COMPLIANCE_COS_TOMBSTONE_PREFIX=deletions/tombstones
COMPLIANCE_PYTHON_BIN=/opt/pjsktools-compliance/venv/bin/python

# Public age recipient only. Generate it offline; never put the identity/private
# key on the production server.
AGE_RECIPIENT=age1replace_with_the_offline_public_recipient

# Docker Compose production locations. No database password is needed here.
COMPOSE_PROJECT_DIR=/opt/pjsktools
COMPOSE_FILE=/opt/pjsktools/compose.prod.yml
COMPOSE_ENV_FILE=/opt/pjsktools/.env.production
POSTGRES_SERVICE=postgres
POSTGRES_USER=pjsktools
POSTGRES_DB=pjsktools

# Monitoring. Alerts always enter syslog; email is used only when sendmail is
# already configured. Keep this as a role address rather than a personal one.
ALERT_EMAIL=sekaitools@qq.com
MONITOR_DISK_PERCENT=85
MONITOR_BACKUP_MAX_AGE_HOURS=30
MONITOR_COS_MAX_AGE_HOURS=30
MONITOR_CERT_HOST=sekai-tools.cn
MONITOR_CERT_MIN_DAYS=21
