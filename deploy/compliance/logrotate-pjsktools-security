/var/log/pjsktools/security.json {
    daily
    rotate 200
    maxage 200
    dateext
    dateyesterday
    dateformat -%Y%m%d
    compress
    missingok
    notifempty
    copytruncate
    su root root
    lastaction
        find /var/log/pjsktools -maxdepth 1 -type f \( -name 'security.json' -o -name 'security*.json.gz' \) -exec chmod 0600 -- {} +
    endscript
}
