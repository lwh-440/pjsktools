# Import exactly one snippet inside Web site blocks only. Start in Report-Only.
# Do not apply this Web policy to the API host, whose response policy is separate.
(web_security_headers_report_only) {
	header {
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://sekai.best; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https://api.sekai-tools.cn https://qzonestyle.gtimg.cn https://*.qlogo.cn https://storage.sekai.best https://storage.exmeaning.com https://storage.pjsk.moe https://moe.exmeaning.com https://production-web.sekai.colorfulpalette.org https://lf3-mkcncdn-tos.dailygn.com; connect-src 'self' https://api.sekai-tools.cn https://sekai.best https://storage.sekai.best https://storage.exmeaning.com https://storage.pjsk.moe https://moe.exmeaning.com https://charts-new.unipjsk.com; media-src 'self' blob: https://api.sekai-tools.cn https://storage.sekai.best https://storage.exmeaning.com https://storage.pjsk.moe https://moe.exmeaning.com; frame-src https://api.sekai-tools.cn; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), publickey-credentials-get=(self), usb=()"
		X-XSS-Protection "0"
	}
}

(web_security_headers_enforced) {
	header {
		-Content-Security-Policy-Report-Only
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://sekai.best; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https://api.sekai-tools.cn https://qzonestyle.gtimg.cn https://*.qlogo.cn https://storage.sekai.best https://storage.exmeaning.com https://storage.pjsk.moe https://moe.exmeaning.com https://production-web.sekai.colorfulpalette.org https://lf3-mkcncdn-tos.dailygn.com; connect-src 'self' https://api.sekai-tools.cn https://sekai.best https://storage.sekai.best https://storage.exmeaning.com https://storage.pjsk.moe https://moe.exmeaning.com https://charts-new.unipjsk.com; media-src 'self' blob: https://api.sekai-tools.cn https://storage.sekai.best https://storage.exmeaning.com https://storage.pjsk.moe https://moe.exmeaning.com; frame-src https://api.sekai-tools.cn; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), publickey-credentials-get=(self), usb=()"
		X-XSS-Protection "0"
	}
}
