# API server
API_HOST=127.0.0.1
PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-in-production

# Haruki-Sekai-API backend.
# If you run Team-Haruki/Haruki-Sekai-API locally with its example backend port,
# this is usually http://127.0.0.1:9999
HARUKI_API_BASE_URL=
HARUKI_PUBLIC_SUITE_BASE_URL=https://suite-api.haruki.seiunx.com/public
HARUKI_OAUTH_AUTHORIZE_URL=
HARUKI_OAUTH_TOKEN_URL=
HARUKI_OAUTH_PROFILE_URL=
HARUKI_OAUTH_BINDINGS_URL=
HARUKI_OAUTH_GAME_DATA_BASE_URL=
HARUKI_OAUTH_REVOKE_URL=
HARUKI_OAUTH_CLIENT_ID=
HARUKI_OAUTH_CLIENT_SECRET=
HARUKI_OAUTH_REDIRECT_URI=http://127.0.0.1:4000/api/auth/haruki/callback
HARUKI_ANDROID_RETURN_URI=https://sekai-tools.cn/auth/haruki
HARUKI_OAUTH_SCOPE="user:read bindings:read game-data:read offline_access"
HARUKI_WEBHOOK_ENABLED=false
HARUKI_WEBHOOK_SYNC_ENABLED=false
HARUKI_WEBHOOK_SECRET=
# Exactly 32 random bytes encoded as base64 or 64 hexadecimal characters.
HARUKI_TOKEN_ENCRYPTION_KEY=
HARUKI_TOKEN_ENCRYPTION_KEY_VERSION=v1
# Comma-separated old version:key pairs retained only while rotating encrypted tokens.
HARUKI_TOKEN_PREVIOUS_ENCRYPTION_KEYS=

# GitHub Raw fallback for collections missing from the metadata source.
MASTER_RAW_BASE_URL=https://raw.githubusercontent.com

# Optional refresh intervals
PLAYER_REFRESH_MS=60000
RANKING_REFRESH_MS=10000
MASTER_REFRESH_MS=43200000

# Optional PostgreSQL persistence. Leave empty to use in-memory development storage.
DATABASE_URL=

# QQ Connect OAuth. Leave empty to keep QQ login disabled.
PUBLIC_WEB_BASE_URL=http://127.0.0.1:5173
QQ_CONNECT_APP_ID=
QQ_CONNECT_APP_KEY=
QQ_CONNECT_REDIRECT_URI=http://127.0.0.1:4000/api/auth/qq/callback
QQ_CONNECT_SCOPE=get_user_info


# QQ email SMTP for verification codes. Put the real authorization code in local .env only.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-qq-email@qq.com
SMTP_PASS=your-qq-mail-authorization-code
SMTP_FROM="Project Sekai Tools <your-qq-email@qq.com>"
